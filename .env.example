# Porta do servidor (API + site em produção) — usado no modo local (server/index.js)
PORT=3000

# Senha do painel do apresentador (/admin) — escolha a sua, não deixe em branco!
ADMIN_PASSWORD=

# --- Necessário apenas no deploy via Netlify + Supabase (server/functions/api.js) ---
# Veja o passo a passo completo no README.md, seção "Hospedar de verdade: Netlify + Supabase"
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# string aleatória longa, ex: gere com `openssl rand -hex 32`
ADMIN_TOKEN_SECRET=
